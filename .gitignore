# Repo-wide ignores. The frontend/ and backend/ directories keep their own
# .gitignore for stack-specific rules; this file covers everything else and
# acts as a backstop if either app is moved or copied.

# --- Secrets / local config -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# --- Dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.venv/
venv/
ENV/

# --- Build output -----------------------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# --- Caches / tooling -------------------------------------------------------
.cache/
.turbo/
.eslintcache
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Local databases / runtime data -----------------------------------------
*.sqlite
*.sqlite3
*.db
backend/uploads/*
!backend/uploads/.gitkeep

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Deploy -----------------------------------------------------------------
.vercel

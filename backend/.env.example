PROJECT_NAME="College Discovery Platform API"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/leadgendb"
SECRET_KEY="change_this_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="http://localhost:3000"
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_API_KEY="change_this_master_key_in_production"

# Sign in with Google. Create an OAuth client (Web) in Google Cloud and paste its client ID. Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=493291589222-n7m6f74tf694lu06k5t7tjr39048i588.apps.googleusercontent.com

# Outgoing email, for password reset codes. Leave SMTP_HOST empty and nothing is sent: the message is written
# to the server log instead (so a developer can read the code).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TopCollegePath <no-reply@topcollegepath.com>"
# Local testing only: return the reset code in the API's answer. Keep this off anywhere real people use it.
RESET_CODE_IN_RESPONSE=false

    {
      "id": "nmat-qs-1",
      "examSlug": "nmat",
      "sectionId": "quantitative-skills",
      "topic": "Arithmetic",
      "difficulty": "easy",
      "type": "mcq-single",
      "stem": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "A train travelling at 60 km/h covers a certain distance in 3 hours. At what speed must it travel to cover the same distance in 2 hours?"
              }
            ]
          }
        ]
      },
      "options": [
        {
          "id": "a",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "75 km/h"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "b",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "80 km/h"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "90 km/h"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "d",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "120 km/h"
                  }
                ]
              }
            ]
          }
        }
      ],
      "correct": {
        "kind": "options",
        "optionIds": [
          "c"
        ]
      },
      "solution": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "The distance is 60 × 3 = 180 km. Covering 180 km in 2 hours needs 90 km/h."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "NMAT carries no negative marking, so there is never a reason to leave a question blank."
              }
            ]
          }
        ]
      },
      "marks": 1,
      "negativeMarks": 0,
      "expectedSeconds": 55
    },
    {
      "id": "nmat-qs-2",
      "examSlug": "nmat",
      "sectionId": "quantitative-skills",
      "topic": "Percentages",
      "difficulty": "medium",
      "type": "mcq-single",
      "stem": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "The price of a commodity rose by 20% and then fell by 20%. What is the net change from the original price?"
              }
            ]
          }
        ]
      },
      "options": [
        {
          "id": "a",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "No change"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "b",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A 4% decrease"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A 4% increase"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "d",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A 2% decrease"
                  }
                ]
              }
            ]
          }
        }
      ],
      "correct": {
        "kind": "options",
        "optionIds": [
          "b"
        ]
      },
      "solution": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Take the price as 100. After a 20% rise it is 120; a 20% fall on 120 removes 24, leaving 96. That is a 4% decrease — the second percentage acts on a larger base than the first, which is why successive equal rises and falls never cancel."
              }
            ]
          }
        ]
      },
      "marks": 1,
      "negativeMarks": 0,
      "expectedSeconds": 60
    },
    {
      "id": "nmat-ls-1",
      "examSlug": "nmat",
      "sectionId": "language-skills",
      "topic": "Vocabulary",
      "difficulty": "medium",
      "type": "mcq-single",
      "stem": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Choose the word most nearly opposite in meaning to CANDID as it is used in: 'She gave a candid assessment of the proposal.'"
              }
            ]
          }
        ]
      },
      "options": [
        {
          "id": "a",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Guarded"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "b",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Hostile"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Detailed"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "d",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Hasty"
                  }
                ]
              }
            ]
          }
        }
      ],
      "correct": {
        "kind": "options",
        "optionIds": [
          "a"
        ]
      },
      "solution": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Candid here means frank and unreserved, so its opposite is guarded — withholding rather than volunteering. 'Hostile' opposes warmth rather than openness; 'detailed' and 'hasty' address length and speed, neither of which is what candid means."
              }
            ]
          }
        ]
      },
      "marks": 1,
      "negativeMarks": 0,
      "expectedSeconds": 45
    },
    {
      "id": "nmat-lr-1",
      "examSlug": "nmat",
      "sectionId": "logical-reasoning",
      "topic": "Deductions",
      "difficulty": "medium",
      "type": "mcq-single",
      "stem": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "All accountants in the firm are members of the institute. Some members of the institute are not partners. Which conclusion necessarily follows?"
              }
            ]
          }
        ]
      },
      "options": [
        {
          "id": "a",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Some accountants in the firm are not partners."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "b",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "No accountant in the firm is a partner."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "All partners are members of the institute."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "d",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "None of the above necessarily follows."
                  }
                ]
              }
            ]
          }
        }
      ],
      "correct": {
        "kind": "options",
        "optionIds": [
          "d"
        ]
      },
      "solution": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "The members who are not partners need not be accountants — they could be any other members. So (A) does not follow. (B) overstates it further, and (C) reverses a relationship the premises never state. Nothing necessarily follows."
              }
            ]
          }
        ]
      },
      "marks": 1,
      "negativeMarks": 0,
      "expectedSeconds": 80
    }

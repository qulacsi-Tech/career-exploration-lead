          "id": "b",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "10%"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "c",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "15%"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "d",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "20%"
                  }
                ]
              }
            ]
          }
        }

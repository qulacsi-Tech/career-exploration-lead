        ]
      },
      "solution": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Take the cost as 100. Marked price is 140; a 25% discount gives a selling price of 140 × 0.75 = 105. Profit is 5 on 100, so 5%."

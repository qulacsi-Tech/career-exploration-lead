# Copy to deploy/.env in EACH checkout on the server and fill in. Never commit the real file.
#   /opt/career-platform/deploy/.env       prod  (also feeds Caddy)
#   /opt/career-platform-dev/deploy/.env   dev
# The matching deploy/backend.env comes from backend.env.example. Use DIFFERENT passwords and
# secrets for dev and prod.

# The public host of THIS environment.
#   prod: topcollegepath.com        dev: dev.topcollegepath.com
DOMAIN=topcollegepath.com

# Letters and digits only (a symbol breaks the database URL in backend.env).
POSTGRES_PASSWORD=CHANGE_ME

# Sign in with Google (optional). The same ID goes in backend.env as GOOGLE_CLIENT_ID.
# Add https://<DOMAIN> under Authorised JavaScript origins. Leave empty to hide the button.
GOOGLE_CLIENT_ID=

# Used only by the manual seed step in docs/deployment-guide.md. With the pipeline, the admin is
# created from ADMIN_EMAIL / ADMIN_PASSWORD in backend.env instead.
ADMIN_EMAIL=admin@topcollegepath.com
ADMIN_PASSWORD=change-me
ADMIN_NAME="Admin"

# --- prod checkout only: read by Caddy, the front door for both domains -------
# Let's Encrypt uses this address for certificate notices.
ACME_EMAIL=you@example.com
# Optional. Defaults to dev.<DOMAIN>.
# DEV_DOMAIN=dev.topcollegepath.com

# --- optional ------------------------------------------------------------------
# API worker processes. 2 is the default; set 1 on dev to save memory.
# BACKEND_WORKERS=1

# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32   (hex only: no / or + in a database URL)

# Public domain. DNS for this name must point at the server's Elastic IP first.
DOMAIN=career.qualcsi.com

# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=you@example.com

# Database password (the database is internal only).
POSTGRES_PASSWORD=change-me

# Used by the seed step to create the demo admin account. Remove after seeding if you like.
ADMIN_EMAIL=admin@career.qualcsi.com
ADMIN_PASSWORD=change-me
ADMIN_NAME="Demo Admin"

# Copy to deploy/backend.env on the server and fill in. Never commit the real file.
# The database host is the compose service name "db", not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@db:5432/leadgendb

# 48+ random characters. Anyone who knows this can forge logins.
SECRET_KEY=change-me-to-a-long-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# The public site. Browsers on this origin may call the API.
CORS_ORIGINS=https://career.qualcsi.com

# Meilisearch is not deployed in this stack. Search falls back to the database.
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# Internal router. Cloudflare Tunnel delivers HTTPS-decrypted requests here on
# port 80, with the public Host header. No certificate is handled by Caddy.
:80 {
	encode zstd gzip

	# The API lives under /api (v1 routes, /api/ping, /api/docs).
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else is the website and the admin panel.
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
